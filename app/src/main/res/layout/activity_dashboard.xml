
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/bg_dashboard_original" android:scaleType="centerCrop" android:alpha="0.3"/>

    <com.carlauncher.hd.RoadView android:id="@+id/roadView" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="100dp"/>

    <TextView android:id="@+id/tvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="18dp" android:text="08:23" android:textSize="36sp" android:textColor="#FFFFFF" android:textStyle="bold"/>
    <TextView android:id="@+id/tvDay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="58dp" android:text="TUESDAY" android:textSize="14sp" android:textColor="#88AACC" android:letterSpacing="0.1"/>

    <LinearLayout android:orientation="vertical" android:layout_width="300dp" android:layout_height="match_parent" android:padding="20dp">
        <TextView android:id="@+id/tvSpeed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="81" android:textSize="90sp" android:textColor="#FFFFFF" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="km/h" android:textSize="20sp" android:textColor="#FFFFFF" android:layout_marginTop="-20dp" android:layout_marginStart="140dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="4dp" android:background="#00BFFF" android:layout_marginTop="10dp"/>
        <TextView android:id="@+id/tvTrip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="02:30" android:textSize="24sp" android:textColor="#FFFFFF" android:layout_marginTop="10dp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TRIP" android:textSize="12sp" android:textColor="#888888"/>
        <com.carlauncher.hd.CompassView android:id="@+id/compassView" android:layout_width="90dp" android:layout_height="90dp" android:layout_marginTop="20dp"/>
        <TextView android:id="@+id/tvCompassTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:12" android:textColor="#55AAFF" android:textSize="14sp" android:layout_marginStart="20dp"/>
    </LinearLayout>

    <FrameLayout android:layout_width="280dp" android:layout_height="300dp" android:layout_gravity="center|end" android:layout_marginEnd="30dp" android:layout_marginTop="60dp">
        <com.carlauncher.hd.PistonView android:id="@+id/pistonView" android:layout_width="match_parent" android:layout_height="match_parent"/>
    </FrameLayout>

    <!-- WEATHER LIVE -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="16dp" android:layout_marginEnd="20dp" android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/tvWeather" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10°" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvWeatherDesc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="light rain
Relax" android:textColor="#88CCFF" android:textSize="14sp" android:gravity="end"/>
    </LinearLayout>

    <com.carlauncher.hd.RpmBarView android:id="@+id/rpmLeft" android:layout_width="22dp" android:layout_height="180dp" android:layout_gravity="bottom|start" android:layout_margin="10dp"/>
    <com.carlauncher.hd.RpmBarView android:id="@+id/rpmRight" android:layout_width="22dp" android:layout_height="180dp" android:layout_gravity="bottom|end" android:layout_margin="10dp"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:orientation="horizontal" android:layout_marginBottom="8dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◀◀   ⏸   ▶▶" android:textColor="#FFFFFF" android:textSize="20sp"/>
    </LinearLayout>

</FrameLayout>
